#!/usr/bin/env bash
# dotsync: pull the chezmoi source repo (fast-forward only) and apply it,
# unless something in $HOME was edited outside chezmoi. Neovim runs this in
# the background on startup; it is just as happy being run by hand.
#
# Spec and tests: tools/dotsync/ in the dotfiles repo.

set -uo pipefail

INTERVAL="${DOTSYNC_INTERVAL:-1800}" # seconds between runs unless --force
STALE_LOCK="${DOTSYNC_STALE_LOCK:-600}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotsync"
LOG="$STATE_DIR/dotsync.log"
STAMP="$STATE_DIR/last-run"
LOCK="$STATE_DIR/lock"

force=0
json=0
quiet=0

usage() {
	cat <<'EOF'
usage: dotsync [--force] [--json] [--quiet]

  --force   ignore the throttle (DOTSYNC_INTERVAL, default 1800s)
  --json    print one JSON object describing the result
  --quiet   print nothing unless something went wrong
EOF
}

for arg in "$@"; do
	case "$arg" in
	--force) force=1 ;;
	--json) json=1 ;;
	--quiet) quiet=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
done

mkdir -p "$STATE_DIR"

log() {
	printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$LOG"
}

json_escape() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$'\n'/\\n}
	s=${s//$'\t'/\\t}
	s=${s//$'\r'/}
	printf '%s' "$s"
}

json_array() {
	local first=1 item
	printf '['
	for item in "$@"; do
		[[ -z "$item" ]] && continue
		((first)) || printf ','
		first=0
		printf '"%s"' "$(json_escape "$item")"
	done
	printf ']'
}

# finish STATUS MESSAGE [exit code]
# Uses the globals changed[], drift[] and nvim_changed. The ${a[@]+...}
# form keeps `set -u` happy on empty arrays in older bash.
changed=()
drift=()
nvim_changed=false
finish() {
	local status=$1 message=$2 code=${3:-0}
	log "$status: $message"
	if ((json)); then
		printf '{"status":"%s","message":"%s","changed":%s,"drift":%s,"nvim_changed":%s}\n' \
			"$status" "$(json_escape "$message")" \
			"$(json_array ${changed[@]+"${changed[@]}"})" "$(json_array ${drift[@]+"${drift[@]}"})" "$nvim_changed"
	elif ((!quiet)) || ((code != 0)); then
		printf 'dotsync: %s\n' "$message"
	fi
	exit "$code"
}

for bin in chezmoi git; do
	if ! command -v "$bin" >/dev/null 2>&1; then
		finish error "$bin is not installed" 1
	fi
done

now=$(date +%s)

# throttle
if ((!force)) && [[ -f "$STAMP" ]]; then
	last=$(<"$STAMP")
	if [[ "$last" =~ ^[0-9]+$ ]] && ((now - last < INTERVAL)); then
		finish skipped_throttle "ran $((now - last))s ago (interval ${INTERVAL}s)"
	fi
fi

# lock: mkdir is atomic; clear a lock left behind by a crashed run
if [[ -d "$LOCK" ]]; then
	lock_age=$((now - $(stat -c %Y "$LOCK" 2>/dev/null || stat -f %m "$LOCK" 2>/dev/null || echo "$now")))
	if ((lock_age > STALE_LOCK)); then
		rmdir "$LOCK" 2>/dev/null
		log "removed stale lock (${lock_age}s old)"
	fi
fi
if ! mkdir "$LOCK" 2>/dev/null; then
	finish skipped_locked "another dotsync is running"
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT
printf '%s\n' "$now" >"$STAMP"

src=$(chezmoi source-path 2>>"$LOG") || finish error "chezmoi source-path failed (see $LOG)" 1
if ! git -C "$src" rev-parse --git-dir >/dev/null 2>&1; then
	finish error "chezmoi source $src is not a git repository" 1
fi
if ! git -C "$src" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
	finish error "chezmoi source has no upstream branch to pull from" 1
fi

before=$(git -C "$src" rev-parse HEAD)
if ! out=$(git -C "$src" pull --ff-only --quiet 2>&1); then
	log "$out"
	finish error "pull failed, local and remote have diverged or the repo is busy (see $LOG)" 1
fi
after=$(git -C "$src" rev-parse HEAD)

if [[ "$before" == "$after" ]]; then
	finish up_to_date "already up to date"
fi

# (a read loop instead of mapfile, which macOS's bash 3.2 lacks)
while IFS= read -r f; do
	[[ -z "$f" ]] && continue
	changed+=("$f")
	if [[ "$f" == dot_config/nvim/* ]]; then
		nvim_changed=true
	fi
done < <(git -C "$src" diff --name-only "$before" "$after")

# drift: the first column of `chezmoi status` is the difference between what
# chezmoi last wrote and what is on disk now, i.e. edits made outside chezmoi
if ! status_out=$(chezmoi status 2>>"$LOG"); then
	finish error "pulled ${#changed[@]} change(s) but chezmoi status failed (see $LOG)" 1
fi
while IFS= read -r line; do
	[[ -z "$line" ]] && continue
	if [[ "${line:0:1}" != " " ]]; then
		drift+=("${line:3}")
	fi
done <<<"$status_out"

if ((${#drift[@]} > 0)); then
	finish skipped_drift "pulled ${#changed[@]} change(s) but did not apply: ${#drift[@]} file(s) edited outside chezmoi"
fi

if ! out=$(chezmoi apply --no-tty 2>&1); then
	log "$out"
	finish error "pulled ${#changed[@]} change(s) but chezmoi apply failed (see $LOG)" 1
fi

msg="synced ${#changed[@]} change(s)"
if [[ "$nvim_changed" == true ]]; then
	msg="$msg; restart Neovim to pick up config changes"
fi
finish synced "$msg"
