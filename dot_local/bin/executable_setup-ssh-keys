#!/usr/bin/env bash

set -euo pipefail
set -x

createKey() {
  local location="$HOME/.ssh/id_ed25519_$1"
  # ssh-keygen reports to stdout, which the caller's $(...) would capture
  # along with the path; send it to the terminal instead. The explicit
  # return is needed because bash turns off set -e inside $(...).
  ssh-keygen -t ed25519 -C "$(whoami)@$(hostname)-$1" \
    -f "$location" >&2 || return

  echo "$location"
}

archieSpot="$(createKey "archie")"
gitSpot="$(createKey "git")"

ssh-add "$archieSpot"
ssh-add "$gitSpot"
