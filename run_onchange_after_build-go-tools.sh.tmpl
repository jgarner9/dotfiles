#!/usr/bin/env bash
# Build the Go tools in tools/ into ~/.local/bin. chezmoi re-runs this script
# only when its rendered text changes, and the hash below changes whenever any
# Go source under tools/ does.
#
# tools hash: {{ $src := "" }}{{ range (glob (joinPath .chezmoi.sourceDir "tools/**/*.go")) }}{{ $src = print $src (include .) }}{{ end }}{{ $src = print $src (include "tools/go.mod") }}{{ $src | sha256sum }}

set -euo pipefail

tools={{ joinPath .chezmoi.sourceDir "tools" | quote }}
bin="$HOME/.local/bin"

if ! command -v go >/dev/null 2>&1; then
	echo "build-go-tools: go is not installed, skipping the Go tools in $tools" >&2
	exit 0
fi

cd "$tools"
mkdir -p "$bin"

# Tests guard the install: a failing tool never replaces a working one. A
# non-zero exit also makes chezmoi retry this script on the next apply.
if ! go test ./... >/dev/null 2>&1; then
	echo "build-go-tools: tests failed, nothing installed (run 'go test ./...' in $tools)" >&2
	exit 1
fi

GOBIN="$bin" go install ./cmd/...
echo "build-go-tools: installed $(find ./cmd -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ') tool(s) to $bin"
