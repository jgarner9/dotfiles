{{- $arch := false }}
{{- if eq .chezmoi.os "linux" }}
{{-   if or (eq .chezmoi.osRelease.id "arch") (contains "arch" (.chezmoi.osRelease.idLike | default "")) }}
{{-     $arch = true }}
{{-   end }}
{{- end }}
{{- if $arch -}}
#!/bin/bash
set -euo pipefail

# Use the socket shipped by Arch's openssh package, shared by all shells.
if [[ ! -f /usr/lib/systemd/user/ssh-agent.socket ]]; then
	echo "ssh-agent: missing systemd socket: run sudo pacman -Syu openssh, then chezmoi apply again" >&2
	exit 1
fi

systemctl --user enable --now ssh-agent.socket
{{ end -}}
