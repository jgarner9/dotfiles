# history
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# MR JASON'S SUPER AWESOME ALIASES
alias claude="headroom wrap claude"
alias spm="sudo pacman"
alias home="ssh jgarner@archie.husky-cobia.ts.net"
alias kb="cargo run --bin tantivy-kb -- --wiki-dir ./wiki"
alias test-type="thokr"
alias epai-sync="export OLD_WD=$PWD; cd $HOME/work_dev/ai-tools; git stash; git pull origin main; git stash pop; bundle exec bin/epai --stdio=bigquery --claude; cd $OLD_WD; unset OLD_WD;"
alias epai-claude="export OLD_WD=$PWD; cd $HOME/work_dev/ai-tools; bundle exec bin/epai --stdio=bigquery --claude; cd $OLD_WD; unset OLD_WD;"
alias saksync="launchctl kickstart -k gui/$(id -u)/dev.jgarner.swiss"
if command -v bat >/dev/null; then
	alias cat="bat"
fi

# add autocompletion
zstyle ':completion:*' menu select
zstyle ':completion:*' rehash true
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# only do the full (slow) compinit scan if the dump is older than 24h
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
	compinit
else
	compinit -C
fi

# customize prompt
autoload -U colors && colors
autoload -U vcs_info
autoload -Uz add-zsh-hook

setopt PROMPT_SUBST
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr '%F{green}+%f'
zstyle ':vcs_info:git:*' unstagedstr '%F{red}*%f'
zstyle ':vcs_info:git:*' formats 'on %F{magenta}git:%F{cyan}(%b)%f%c%u'
zstyle ':vcs_info:git:*' actionformats 'on %F{magenta}git:%F{cyan}(%b|%a)%f%c%u'

add-zsh-hook precmd vcs_info

PROMPT='%F{cyan}%n%f@%F{blue}%m%f in %F{yellow}%~%f ${vcs_info_msg_0_}
'
PROMPT+='%(?.%F{green}.%F{red})❯%f '

# search history by what's already typed instead of plain scrolling
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward

# personal tools (dotfiles dot_local/bin and Go tools built from tools/)
# land here; set before zellij starts so every pane inherits it
export PATH="$HOME/.local/bin:$PATH"

# pull and apply the latest dotfiles, overwriting any local edits without
# prompting; skipped inside zellij so it runs once per window, not per pane
if [[ -z $ZELLIJ ]] && command -v chezmoi >/dev/null; then
	chezmoi update --force > /dev/null 2>&1 &
fi

# not over SSH: you're usually already inside a local zellij, and a nested
# one loses its keybinds to the outer session (run `zellij attach -c` by
# hand for a remote session that survives disconnects)
if command -v zellij >/dev/null && [[ -z $SSH_CONNECTION ]]; then
	# exit the shell when zellij exits, so closing zellij closes the window
	# (pairs with on_force_close "quit" in the zellij config)
	export ZELLIJ_AUTO_EXIT=true
	eval "$(zellij setup --generate-auto-start zsh)"
fi

if command -v zoxide >/dev/null; then
	eval "$(zoxide init --cmd cd zsh)"
fi

# lazy-load nvm: shells start fast, nvm loads on first use of nvm/node/npm/npx
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
	_load_nvm() {
		unset -f nvm node npm npx _load_nvm
		\. "$NVM_DIR/nvm.sh"
		[[ -s "$NVM_DIR/bash_completion" ]] && \. "$NVM_DIR/bash_completion"
	}
	nvm() { _load_nvm && nvm "$@" }
	node() { _load_nvm && node "$@" }
	npm() { _load_nvm && npm "$@" }
	npx() { _load_nvm && npx "$@" }
fi

# load .zprofile if not a login shell (zellij handling, non-login shells on launch)
[[ -o login ]] || source "$HOME/.zprofile"

# source plugins (syntax-highlighting must stay last)
if [[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
	source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
if [[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
	source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
